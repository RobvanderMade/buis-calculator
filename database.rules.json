{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "customers": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "materials": {
      ".read": true,
      "$materialId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "siteContent": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')"
    },

    "pricing": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')"
    },

    "requests": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')",
      "$requestId": {
        ".read": "auth != null && ((root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin') || data.child('customerUid').val() === auth.uid)",
        ".write": "auth != null && ((root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin') || (!data.exists() && newData.child('customerUid').val() === auth.uid && newData.child('status').val() === 'nieuw'))"
      }
    },

    "requestCounters": {
      "sequence": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "customerRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')",
        "$requestId": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'true' || root.child('admins').child(auth.uid).child('enabled').val() === true || root.child('admins').child(auth.uid).child('role').val() === 'admin'))"
        }
      }
    }
  }
}
